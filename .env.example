# Copy to .env and fill in. .env must never be committed.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Where decoded records are written. Without it the listener still runs and
# writes JSONL, but nothing reaches the database.
#   Railway  -> Variables tab, DATABASE_PUBLIC_URL (*.proxy.rlwy.net:<port>)
#   local    -> postgresql://teltonika:<password>@127.0.0.1:5432/teltonika
DATABASE_URL=

# Comma or whitespace separated IMEIs permitted to connect. WITHOUT THIS THE
# LISTENER ACCEPTS ANY DEVICE, so anyone who finds port 5027 can inject
# positions for arbitrary vehicles. Non-numeric entries abort startup.
TELTONIKA_ALLOWED_IMEIS=

# ---------------------------------------------------------------------------
# docker-compose.yml only (ignored when the database is hosted elsewhere)
#   openssl rand -base64 24
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Optional. NOTE: these have no effect in the Docker image, because the
# Dockerfile CMD passes the equivalent flags explicitly and a CLI argument
# always beats an environment default. To change them in a container, override
# the start command instead.
# ---------------------------------------------------------------------------
# TELTONIKA_HOST=0.0.0.0
# TELTONIKA_PORT=5027
# TELTONIKA_LOG_DIR=./logs
# TELTONIKA_LOG_LEVEL=INFO
# TELTONIKA_IDLE_TIMEOUT=600
# TELTONIKA_MAX_CONNECTIONS=500
# TELTONIKA_IO_DEFS=io_definitions.json

# Path to an allowlist file. An alternative to TELTONIKA_ALLOWED_IMEIS above;
# this one does work in the container, since --allowlist is not in the CMD.
# TELTONIKA_ALLOWLIST=/opt/teltonika/allowed_imeis.txt
