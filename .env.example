# Copy to .env and fill in. .env must never be committed.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Where decoded records are written. Without it the listener still runs and
# writes JSONL, but nothing reaches the database.
#   Railway, same project -> ${{timescaledb.DATABASE_URL}}  (private network)
#   Railway, from outside -> DATABASE_PUBLIC_URL (*.proxy.rlwy.net:<port>)
#   local docker-compose  -> built automatically from POSTGRES_PASSWORD
DATABASE_URL=

# Comma or whitespace separated IMEIs permitted to connect. WITHOUT THIS THE
# LISTENER ACCEPTS ANY DEVICE, so anyone who finds the port can inject
# positions for arbitrary vehicles. Non-numeric entries abort startup.
TELTONIKA_ALLOWED_IMEIS=

# ---------------------------------------------------------------------------
# docker-compose.yml only (ignored when the database is hosted elsewhere)
#   openssl rand -base64 24
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Optional. The Dockerfile sets these as ENV defaults and passes no CLI flags,
# so overriding them here or in the platform's variables works.
# ---------------------------------------------------------------------------

# On Railway this MUST point at the mounted volume, or logs are lost on every
# redeploy (the filesystem is ephemeral). Image default: /var/log/teltonika
# TELTONIKA_LOG_DIR=/data/logs

# TELTONIKA_HOST=0.0.0.0
# TELTONIKA_PORT=5027
# TELTONIKA_LOG_LEVEL=INFO
# TELTONIKA_IDLE_TIMEOUT=600
# TELTONIKA_MAX_CONNECTIONS=500
# TELTONIKA_IO_DEFS=/opt/teltonika/io_definitions.json

# Allowlist from a file instead of TELTONIKA_ALLOWED_IMEIS above.
# TELTONIKA_ALLOWLIST=/opt/teltonika/allowed_imeis.txt
